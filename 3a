# ============================================================
# 12. ROC CURVE - IRIS
# ============================================================

def plot_roc_curve(
    model,
    X,
    y,
    class_names,
    title
):

    probabilities = cross_val_predict(
        model,
        X,
        y,
        cv=cv,
        method="predict_proba"
    )

    plt.figure()

    if len(class_names) == 2:

        fpr, tpr, _ = roc_curve(
            y,
            probabilities[:, 1]
        )

        auc = roc_auc_score(
            y,
            probabilities[:, 1]
        )

        plt.plot(
            fpr,
            tpr,
            label=f"AUC = {auc:.3f}"
        )

    else:

        for i, class_name in enumerate(
            class_names
        ):

            y_binary = (
                y == i
            ).astype(int)

            fpr, tpr, _ = roc_curve(
                y_binary,
                probabilities[:, i]
            )

            auc = roc_auc_score(
                y_binary,
                probabilities[:, i]
            )

            plt.plot(
                fpr,
                tpr,
                label=f"{class_name} AUC={auc:.3f}"
            )

    plt.plot(
        [0, 1],
        [0, 1],
        linestyle="--"
    )

    plt.xlabel("False Positive Rate")
    plt.ylabel("True Positive Rate")

    plt.title(title)

    plt.legend()

    plt.show()


