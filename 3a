# ============================================================
# 1. ENTROPY FUNCTION
# ============================================================

def calculate_entropy(y):
    values, counts = np.unique(y, return_counts=True)

    probabilities = counts / counts.sum()

    entropy = -np.sum(
        probabilities * np.log2(probabilities)
    )

    return entropy


